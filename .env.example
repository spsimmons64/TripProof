# --- Database (existing MariaDB) ---------------------------------------------------------------
DB_HOST=DBServer
DB_PORT=3306
DB_NAME=tripproof
DB_USER=tripproof
DB_PASSWORD=

# --- Secrets -----------------------------------------------------------------------------------
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# One or more "version:base64-32-byte-key", comma separated; the highest version encrypts new data.
# python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes all PHI and stored documents unreadable. Keep it in a secrets manager.
PHI_KEYS=

# --- Web ---------------------------------------------------------------------------------------
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# --- Email (invitations / password resets) -----------------------------------------------------
# Leave SMTP_HOST empty in development: the admin portal then shows the invitation link to copy.
SMTP_HOST=mail.beyondmybooks.com
SMTP_PORT=587
SMTP_USER=noreply@tripproofonline.com
SMTP_PASSWORD=
SMTP_FROM="Trip Proof Online <noreply@tripproofonline.com>"
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Stripe (online application: card verification + customer) --------------------------------
# Use test keys (sk_test_…, pk_test_…) until you go live. Empty = card step can be skipped (dev only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret (whsec_…) of the webhook endpoint https://<your domain>/api/billing/webhook — see
# README "Billing after signup" for the events to subscribe. In development, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=
